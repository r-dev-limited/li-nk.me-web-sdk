{
  "name": "@li-nk.me/web-sdk",
  "version": "0.2.14",
  "description": "Zero-dependency browser SDK for LinkMe deep and deferred links.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "!dist/**/*.test.*"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "linkme",
    "deep-linking",
    "deferred",
    "web",
    "sdk"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/r-dev-limited/li-nk.me-web-sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
